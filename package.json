{
  "name": "celmbot",
  "version": "0.1.0",
  "description": "Local verification-first agent playground for free-tier multi-key workflows",
  "license": "MIT",
  "type": "module",
  "bin": {
    "celmbot": "./dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/cli.ts -- --no-open",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/cli.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:jail": "vitest run tests/unit/pathGuard.test.ts tests/unit/recipes.test.ts",
    "test:live": "node scripts/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "web/dist",
    "providers",
    "skills",
    "docs",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.1",
    "monaco-editor": "^0.57.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
