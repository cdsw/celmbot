# Optional CelmBot environment overrides (no secrets here).
# Copy to .env if you use a dotenv loader locally — CelmBot itself reads process env.

# HTTP listen port (default 7429; CLI also tries 7429–7439)
# CELMBOT_PORT=7429

# Config + key storage directory (default: ~/.celmbot)
# CELMBOT_CONFIG_DIR=/absolute/path/to/.celmbot

# Skip opening a browser on start (also: --no-open)
# BROWSER=none

# Opt-in live smoke against real keys (see docs/LIVE_SMOKE.md)
# CELMBOT_LIVE=1

# Opt-in Playwright Chromium UI checks (e2e/ui.browser.spec.ts)
# CELMBOT_BROWSER_E2E=1
